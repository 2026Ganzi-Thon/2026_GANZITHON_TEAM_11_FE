{
  "expo": {
    "name": "양 세는 밤",
    "slug": "yangsebam",
    "version": "0.1.0",
    "scheme": "yangsebam",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": ["android"],
    "android": {
      "package": "com.ganzithon.yangsebam"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "NotoSansKR",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/noto-sans-kr/400Regular/NotoSansKR_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/noto-sans-kr/700Bold/NotoSansKR_700Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ]
    ]
  }
}
